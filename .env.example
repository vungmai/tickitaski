# Firebase project config (Project Settings > General > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Anthropic API key
# WARNING: calling the Anthropic API directly from the browser exposes this key to anyone
# who opens devtools. Fine for local prototyping; before shipping, move these calls behind
# a small backend/Cloud Function and drop VITE_ANTHROPIC_DANGEROUSLY_ALLOW_BROWSER.
VITE_ANTHROPIC_API_KEY=
